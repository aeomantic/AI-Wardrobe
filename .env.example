# Optional. The backend uses its deterministic local provider when this is blank.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Set to true when live vision failures must fail instead of using the mock.
AI_WARDROBE_STRICT_PROVIDER=false

# Optional media controls.
AI_WARDROBE_MAX_IMAGE_BYTES=26214400
AI_WARDROBE_MAX_VIDEO_BYTES=26214400
AI_WARDROBE_MAX_DIMENSION=1600
FFMPEG_BINARY=ffmpeg
